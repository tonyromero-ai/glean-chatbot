# Copy to .env and fill in real values. Do not commit .env.

# Glean instance name. Backend host is https://<instance>-be.glean.com
export GLEAN_INSTANCE="support-lab"

# Indexing API token (scope: indexing).
export GLEAN_INDEXING_TOKEN="paste-indexing-token-here"

# Client API token (scopes: Search, Chat).
export GLEAN_CLIENT_TOKEN="paste-client-token-here"

# User email for X-Glean-ActAs (required with a global Client API token).
export GLEAN_ACT_AS="your-glean-user@example.com"

# Datasource to index into / retrieve from.
export GLEAN_DATASOURCE="interviewds"

# Human-readable name shown in the Glean UI.
export GLEAN_DATASOURCE_DISPLAY="Finance Evolution Corp"

# Every document viewURL must match this regex.
export GLEAN_URL_REGEX="^https://financeevolution.internal/.*"
